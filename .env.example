# Copy to .env.local and fill in your own values.
# These have safe public fallbacks in src/lib/supabase.ts and src/lib/cloudinary.ts,
# but setting them explicitly is recommended for deploys.

# Supabase project (publishable/anon key only — never the service_role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Cloudinary unsigned upload preset for avatars (max 10 MB)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
